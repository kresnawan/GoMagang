# Templat unit Quadlet (Podman + systemd) untuk backend GoMagang.
#
# scripts/deploy.sh mengirim file ini ke VPS, lalu scripts/deploy-remote.sh mengisi @...@ dan
# memasangnya di ~/.config/containers/systemd/gomagang-backend.container. Dari situ systemd membuat
# gomagang-backend.service: dijalankan saat boot (butuh linger), dan di-restart bila crash.
#
# Jangan ubah file yang terpasang di VPS secara manual; deploy berikutnya menimpanya.

[Unit]
Description=GoMagang backend
Wants=network-online.target
After=network-online.target

[Container]
Image=@IMAGE@
ContainerName=gomagang-backend
# Semua konfigurasi dan secret dibaca dari file env di VPS, bukan ditanam di image.
# Podman tidak membuang tanda kutip, jadi nilai di file ini ditulis tanpa tanda kutip.
EnvironmentFile=@ENV_FILE@
Environment=UPLOAD_DIR=/data/uploads
# Volume bernama: saat pertama dibuat, Podman menyalin isi dan kepemilikan folder dari image
# (UID 10001), jadi tidak perlu chown manual.
Volume=gomagang_uploads:/data/uploads
# Network milik container PostgreSQL; backend menghubunginya lewat nama container.
Network=@NETWORK@
# Bawaan hanya terbuka untuk VPS itu sendiri; akses publik lewat reverse proxy atau tunnel.
PublishPort=@BIND@:3000
# Init kecil sebagai PID 1 yang meneruskan sinyal ke server dan membereskan proses zombie.
PodmanArgs=--init

[Service]
Restart=always
RestartSec=5
# Server menyelesaikan request yang sedang berjalan setelah SIGTERM.
TimeoutStopSec=30

[Install]
WantedBy=default.target
