# Templat konfigurasi produksi backend GoMagang.
#
# Salin menjadi .env.production di folder deploy di VPS (bawaan ~/gomagang), isi nilainya, lalu
# jalankan ulang scripts/deploy.sh. File ini hanya ada di VPS dan tidak pernah dikirim dari laptop.
# Tulis nilai apa adanya, TANPA tanda kutip: Podman tidak membuangnya, dan deploy menolak file yang
# memakainya.

# ---- Wajib ----------------------------------------------------------------------------------

# Host-nya adalah nama container PostgreSQL (atau alias-nya) di network Podman yang sama, bukan
# localhost. Bila role dan database belum ada, scripts/deploy.sh membuatnya dari nilai ini.
# Karakter khusus di password harus di-percent-encode (mis. @ menjadi %40), atau pakai password
# yang hanya berisi huruf dan angka: openssl rand -hex 24
DATABASE_URL=postgres://gomagang:GANTI_PASSWORD@postgres:5432/gomagang

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Minimal 32 byte: openssl rand -base64 48
JWT_SECRET=

# ---- URL publik -----------------------------------------------------------------------------

# Harus sama dengan redirect URI di Google Cloud Console. Bila diawali https://, cookie sesi
# diberi atribut Secure.
GOOGLE_REDIRECT_URI=https://api.contoh.com/auth/google
FRONTEND_URL=https://gomagang.contoh.com
# Daftar origin frontend, dipisah koma.
CORS_ALLOWED_ORIGINS=https://gomagang.contoh.com

# ---- Opsional -------------------------------------------------------------------------------

# Seed Ed25519 untuk tanda tangan surat keterangan: openssl rand -base64 32
# JANGAN diganti setelah ada surat yang terbit.
SURAT_SIGNING_KEY=

# Kosongkan SMTP_HOST untuk mematikan email.
SMTP_HOST=
SMTP_PORT=
SMTP_TLS=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=Panitia Magang <magang@contoh.com>

# Mengaktifkan POST /api/v1/panitia-magang. Minimal 32 byte bila diisi.
ADMIN_SECRET=

RUST_LOG=gomagang=info,tower_http=info
